# BONANZA production settings: the template for /opt/bonanza/.env.
#
#   install -m 600 .env.production.example /opt/bonanza/.env    # then fill it in
#
# Read by Docker Compose (compose.prod.yaml), which hands each container only
# the values it needs. Format: KEY=value, one per line, no spaces around "=".
# Wrap a value that contains "$" in single quotes.
#
# This file contains placeholders only. The real file holds secrets: it stays
# on the server (mode 600) and in the owner's password manager, never in git.
#
# Generate each secret separately:
#   openssl rand -hex 32

# ── Ingress ──────────────────────────────────────────────────────────────────
# How web traffic reaches the server. Must agree with ingress_mode in
# Terraform (docs/oracle-deployment.md, step 8).
#   tunnel   through Cloudflare Tunnel; no port is published
#   direct   Caddy publishes 80 and 443 and obtains its own certificates
COMPOSE_PROFILES=tunnel

# Tunnel mode: the token of the Cloudflare Tunnel (a secret).
TUNNEL_TOKEN=

# ── Hostnames ────────────────────────────────────────────────────────────────
# Names only: no "https://", no path. In direct mode, before the domain
# exists, names such as shop.203-0-113-7.sslip.io resolve to the address
# written in them.
STOREFRONT_HOST=shop.example.com
API_HOST=api.example.com
DASHBOARD_HOST=dashboard.example.com

# Optional second name of the shop that redirects to STOREFRONT_HOST (plain
# HTTP at the server; Cloudflare serves the HTTPS side).
# STOREFRONT_WWW_HOST=www.example.com

# The public addresses follow from the hostnames (https://<host>). Set these
# only when that is not what browsers use, for example on a non-standard port.
# STOREFRONT_URL=https://shop.example.com
# MEDUSA_BACKEND_URL=https://api.example.com
# STORE_CORS=https://shop.example.com
# ADMIN_CORS=https://dashboard.example.com
# AUTH_CORS=https://shop.example.com,https://dashboard.example.com

# ── Deployment ───────────────────────────────────────────────────────────────
# production | staging. Only "staging" may switch on the simulated payment
# provider further down.
APP_ENV=production

# ── Secrets ──────────────────────────────────────────────────────────────────
# PostgreSQL password for the user "bonanza". Letters and digits only: it is
# placed inside a connection URL. It is applied when the database volume is
# first created; changing it here later does not change the database.
POSTGRES_PASSWORD=

# Sign customer and admin tokens and the admin session cookie. Changing them
# signs everyone out.
JWT_SECRET=
COOKIE_SECRET=
# Optional. How long a sign-in token stays valid.
# JWT_EXPIRES_IN=7d

# Encrypts admin two-factor (TOTP) secrets. Changing it invalidates every
# enrolled device.
AUTH_MFA_ENCRYPTION_KEY=

# Shared by the backend and the storefront: page refresh requests, the signed
# visitor address behind per-visitor sign-in limits, and preview links for
# unpublished content.
REVALIDATE_SECRET=
CMS_PREVIEW_SECRET=

# ── Storefront ───────────────────────────────────────────────────────────────
# Publishable API key (starts with "pk_"). Not a secret. It is created by the
# first migration run; see README.md, "First start".
MEDUSA_PUBLISHABLE_KEY=

# Country code of the single sales region.
DEFAULT_COUNTRY=il

# Keep false on temporary addresses so search engines do not index them. Set
# true only on the real domain.
ALLOW_INDEXING=false

# ── Email (SMTP) ─────────────────────────────────────────────────────────────
# Leave SMTP_HOST empty to send no email at all.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=BONANZA <no-reply@example.com>

# ── Media storage (Cloudflare R2, S3 API) ────────────────────────────────────
# Leave S3_BUCKET empty only for a trial: uploads then go to a Docker volume
# on the server, which is not backed up.
S3_BUCKET=
S3_REGION=auto
# https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_ENDPOINT=
# The bucket's public address, no trailing slash. Its hostname must also be
# given to the storefront image when it is built (README.md, "Building").
S3_FILE_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PREFIX=
S3_FORCE_PATH_STYLE=false

# ── Rate limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true

# ── Simulated payment provider (staging only) ────────────────────────────────
# The backend refuses to start if this is true while APP_ENV=production.
PAYMENT_DEV_ENABLED=false
PAYMENT_DEV_WEBHOOK_SECRET=
# automatic: a charge is captured when approved. manual: it is only
# authorized, and captured later from the admin.
# PAYMENT_DEV_CAPTURE_MODE=automatic

# ── Direct mode only ─────────────────────────────────────────────────────────
# Where the proxy listens. The defaults are right on the server; a trial on a
# development machine uses loopback and high ports (README.md).
# DIRECT_HTTP_BIND=0.0.0.0:80
# DIRECT_HTTPS_BIND=0.0.0.0:443
# "public" (default): real certificates. "internal": Caddy's own authority,
# for a trial on a development machine.
# CADDY_TLS=public
