# BONANZA — environment variables
#
# This file is the single documented list of every variable the project reads.
# It contains no real secrets and is safe to commit.
#
# `pnpm dev:setup` turns each "#@file <path>" section below into that file, replacing
# every __GENERATE__ with a fresh random value. Existing files are never
# overwritten. The generated files are gitignored.
#
# In production these values come from the server's environment
# (infrastructure/docker/.env.production.example), not from these files.

#@file apps/backend/.env
# ── Deployment ───────────────────────────────────────────────────────────────
# development | staging | production. Decides which safety checks apply.
# NODE_ENV is separate: a locally run production build is APP_ENV=staging.
APP_ENV=development

# ── Data stores ──────────────────────────────────────────────────────────────
DATABASE_URL=postgres://bonanza:bonanza@localhost:5432/bonanza
# Event bus, workflow engine, locks and admin sessions. Leave empty to use
# Medusa's in-memory modules (single process only).
REDIS_URL=redis://localhost:6379

# ── URLs ─────────────────────────────────────────────────────────────────────
# Public URL of this backend. Used for uploaded file links and payment webhooks.
MEDUSA_BACKEND_URL=http://localhost:9000
# Public URL of the storefront. Used in emails and for cache revalidation.
STOREFRONT_URL=http://localhost:8000
# Optional. How the backend reaches the storefront when the public URL does not
# resolve from inside its own network (Docker). Defaults to STOREFRONT_URL.
# STOREFRONT_INTERNAL_URL=http://storefront:8000

# ── CORS allowlists (comma-separated origins) ────────────────────────────────
STORE_CORS=http://localhost:8000
ADMIN_CORS=http://localhost:9000,http://localhost:5173
AUTH_CORS=http://localhost:8000,http://localhost:9000,http://localhost:5173

# ── Secrets ──────────────────────────────────────────────────────────────────
# Sign customer/admin tokens and the admin session cookie. Required in production.
JWT_SECRET=__GENERATE__
COOKIE_SECRET=__GENERATE__
# Optional. How long a sign-in token stays valid. Default: 7d.
# JWT_EXPIRES_IN=7d
# Encrypts admin two-factor (TOTP) secrets. Changing it invalidates enrolled devices.
AUTH_MFA_ENCRYPTION_KEY=__GENERATE__

# ── Process mode ─────────────────────────────────────────────────────────────
# shared (dev) | server (HTTP only) | worker (jobs and subscribers only)
MEDUSA_WORKER_MODE=shared
DISABLE_MEDUSA_ADMIN=false
MEDUSA_DISABLE_TELEMETRY=true

# ── First admin user (used once by `pnpm dev:setup`) ─────────────────────────────
ADMIN_EMAIL=admin@bonanza.test
ADMIN_PASSWORD=__GENERATE__

# ── Email (SMTP) ─────────────────────────────────────────────────────────────
# Local default is Mailpit from compose.yaml: http://localhost:8025
# Leave SMTP_HOST empty to disable email.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=BONANZA <no-reply@bonanza.test>

# ── File storage ─────────────────────────────────────────────────────────────
# Empty S3_BUCKET = store uploads on local disk (development only).
# Cloudflare R2: region "auto", endpoint https://<ACCOUNT_ID>.r2.cloudflarestorage.com,
# S3_FILE_URL = the bucket's public custom domain, no trailing slash.
# MinIO from `docker compose --profile s3 up -d`:
#   S3_BUCKET=bonanza-media  S3_ENDPOINT=http://localhost:9100
#   S3_FILE_URL=http://localhost:9100/bonanza-media  S3_FORCE_PATH_STYLE=true
#   S3_ACCESS_KEY_ID=bonanza  S3_SECRET_ACCESS_KEY=bonanza-dev-secret
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_FILE_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PREFIX=
S3_FORCE_PATH_STYLE=false

# ── Development payment provider ─────────────────────────────────────────────
# A simulated hosted payment page. The backend refuses to start if this is true
# while APP_ENV=production.
PAYMENT_DEV_ENABLED=true
PAYMENT_DEV_WEBHOOK_SECRET=__GENERATE__
# Optional. Where the payment provider reaches the simulated gateway from
# inside the backend's own network (Docker). Defaults to MEDUSA_BACKEND_URL.
# PAYMENT_DEV_GATEWAY_URL=http://medusa-server:9000
# Optional. automatic: the charge is captured when approved (default).
# manual: it is only authorized, and captured later from the admin.
# PAYMENT_DEV_CAPTURE_MODE=automatic

# ── Shared with the storefront (must match its values) ───────────────────────
# The secret the backend and the storefront share. It authorizes the backend's
# requests to refresh cached pages, and signs the visitor address the
# storefront reports so sign-in rate limits count per visitor.
REVALIDATE_SECRET=__GENERATE__
# Signs short-lived links for previewing unpublished content.
CMS_PREVIEW_SECRET=__GENERATE__

# ── Rate limiting ────────────────────────────────────────────────────────────
# Applies to login, registration, password reset and newsletter sign-up.
RATE_LIMIT_ENABLED=true
# Set to true only when the backend sits behind Cloudflare, so the visitor's
# address is read from CF-Connecting-IP.
TRUST_CLOUDFLARE_IP=false

#@file apps/storefront/.env.local
# ── URLs ─────────────────────────────────────────────────────────────────────
# Public URL of the storefront. Used for canonical links, the sitemap and Open Graph.
SITE_URL=http://localhost:8000
# Medusa backend, as reached from the storefront server.
MEDUSA_BACKEND_URL=http://localhost:9000

# ── Medusa ───────────────────────────────────────────────────────────────────
# Publishable API key. Not a secret. `pnpm dev:setup` fills it in from the database;
# it is also shown in the admin under Settings → Publishable API Keys.
MEDUSA_PUBLISHABLE_KEY=__PUBLISHABLE_KEY__
# Country code of the single sales region.
DEFAULT_COUNTRY=il

# ── Shared with the backend (must match its values) ──────────────────────────
REVALIDATE_SECRET=__GENERATE__
CMS_PREVIEW_SECRET=__GENERATE__

# ── Search engines ───────────────────────────────────────────────────────────
# Keep false on temporary URLs so they are not indexed. Set true only on the
# real production domain.
ALLOW_INDEXING=false

# ── Images ───────────────────────────────────────────────────────────────────
# Comma-separated hostnames product images may be loaded from.
IMAGE_HOSTNAMES=localhost
