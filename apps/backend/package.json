{
  "name": "@bonanza/backend",
  "version": "0.1.0",
  "private": true,
  "description": "BONANZA commerce backend and admin (Medusa v2).",
  "scripts": {
    "build": "medusa build",
    "start": "medusa start",
    "dev": "medusa develop",
    "lint": "medusa lint",
    "typecheck": "tsc --noEmit",
    "predeploy": "medusa db:migrate",
    "db:migrate": "medusa db:migrate",
    "db:generate": "medusa db:generate",
    "seed:demo": "medusa exec ./src/scripts/seed-demo.ts",
    "test": "pnpm run test:unit",
    "test:unit": "TEST_TYPE=unit NODE_OPTIONS=--experimental-vm-modules jest --silent --runInBand --forceExit --passWithNoTests",
    "test:integration:modules": "TEST_TYPE=integration:modules NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:integration:http": "TEST_TYPE=integration:http NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit"
  },
  "dependencies": {
    "@medusajs/admin-sdk": "2.23.0",
    "@medusajs/admin-shared": "2.23.0",
    "@medusajs/caching": "2.23.0",
    "@medusajs/cli": "2.23.0",
    "@medusajs/dashboard": "2.23.0",
    "@medusajs/draft-order": "2.23.0",
    "@medusajs/framework": "2.23.0",
    "@medusajs/medusa": "2.23.0",
    "@medusajs/ui": "4.3.0",
    "@tanstack/react-query": "5.107.1",
    "ioredis": "^6.0.0",
    "nodemailer": "^7.0.13",
    "rate-limiter-flexible": "^11.5.0",
    "react-i18next": "18.0.1",
    "react-router-dom": "7.18.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@bonanza/types": "workspace:*",
    "@medusajs/test-utils": "2.23.0",
    "@swc/core": "^1.7.28",
    "@swc/jest": "^0.2.36",
    "@types/jest": "^29.5.13",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jest": "^29.7.0",
    "prop-types": "^15.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "vite": "^8.3.8"
  },
  "engines": {
    "node": ">=22.22.0"
  }
}
